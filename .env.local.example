# Railway FastAPI backend. Defaults to the production URL in lib/api.ts if unset.
NEXT_PUBLIC_API_BASE_URL=https://ptolemy-production.up.railway.app

# Stripe Checkout and the Billing Portal are both hosted, redirect-only
# flows (see lib/api.ts createCheckoutSession/createPortalSession) -- the
# frontend never talks to Stripe directly, so no Stripe key belongs here.
# All Stripe config (STRIPE_SECRET_KEY, STRIPE_PRICE_ID,
# STRIPE_WEBHOOK_SECRET) lives on the backend instead.
